<div class="app-container">
    <!-- Sidebar -->
    <div class="sidebar">
        <div class="sidebar-header">
            <h2>FlexySSH</h2>
            <div class="sidebar-buttons">
                <button type="button" id="addServerBtn" class="icon-btn add-server-btn" title="Add Server">
                    <i class="fas fa-plus"></i>
                </button>
                <button type="button" id="snippetsBtn" class="icon-btn snippets-btn" title="Code Snippets">
                    <i class="fas fa-code"></i>
                </button>
                <button type="button" id="addFolderBtn" class="icon-btn add-folder-btn" title="Add Folder">
                    <i class="fas fa-folder-plus"></i>
                </button>
                <button type="button" id="manageIdentitiesBtn" class="icon-btn manage-identities-btn" title="Manage Identities">
                    <i class="fas fa-user-shield"></i>
                </button>
            </div>
        </div>
        
        <div class="server-list-container">
            <div class="server-list" id="serverList">
                <div class="loading">Loading...</div>
            </div>
        </div>
        
        <div class="sidebar-footer">
            <div class="sidebar-footer-buttons">
                <button type="button" id="refreshBtn" class="refresh-btn">Refresh</button>
                <a href="/logout" class="logout-btn"><i class="fas fa-sign-out-alt"></i> Logout</a>
            </div>
        </div>
    </div>
    
    <!-- Main Content -->
    <div class="main-content">
        <!-- Tab Navigation -->
        <div class="tab-navigation">
            <div class="tab-list" id="tabList">
                <!-- Tabs will be added here dynamically -->
            </div>
            <button id="closeAllTabsBtn" class="close-all-tabs-btn" title="Close All Tabs">
                <span>×</span>
            </button>
        </div>
        
        <!-- Terminal Container -->
        <div class="terminal-toolbar" id="terminalToolbar">
            <div class="terminal-toolbar-left">
                <span class="terminal-title" id="currentTerminalTitle">Terminal</span>
            </div>
            <div class="terminal-toolbar-right">
                <div class="terminal-snippets-dropdown">
                    <button type="button" id="terminalSnippetsBtn" class="terminal-toolbar-btn" title="Use Snippets">
                        <i class="fas fa-code"></i>
                    </button>
                    <div class="terminal-snippets-content" id="terminalSnippetsContent">
                        <!-- Snippets will be loaded here dynamically -->
                        <div class="loading-snippets">Loading snippets...</div>
                    </div>
                </div>
                <button type="button" id="fileExplorerBtn" class="terminal-toolbar-btn" title="File Explorer">
                    <i class="fas fa-folder"></i>
                </button>
                <button type="button" id="fullscreenBtn" class="terminal-toolbar-btn" title="Toggle Fullscreen">
                    <i class="fas fa-expand"></i>
                </button>
            </div>
        </div>
        <div class="terminal-container" id="terminalContainer">
            <!-- Terminal tabs will be added here dynamically -->
            <div class="welcome-screen" id="welcomeScreen">
                <div class="welcome-content">
                    <h2>Welcome to FlexySSH</h2>
                    <p>Select a server from the sidebar to open a new connection tab.</p>
                </div>
            </div>
        </div>
    </div>
    
    <!-- Add Server Modal -->
    <div id="saveServerModal" class="modal">
        <div class="modal-content">
            <span class="close">&times;</span>
            <h2>Add Server</h2>
            <form id="saveServerForm">
                <div class="form-group">
                    <label for="serverName">Server Name</label>
                    <input type="text" id="serverName" required>
                </div>
                <div class="form-group">
                    <label for="folderSelector">Folder (Optional)</label>
                    <select id="folderSelector">
                        <option value="">- No Folder -</option>
                        <!-- Folders will be loaded here -->
                    </select>
                </div>
                <div class="form-group">
                    <label for="serverHost">Host</label>
                    <input type="text" id="serverHost" required>
                </div>
                
                <div class="form-group">
                    <label>User Identity</label>
                    <div class="identity-options">
                        <div class="identity-selection">
                            <select id="identitySelector">
                                <option value="manual">Enter Manually</option>
                                <!-- Identities will be loaded here -->
                            </select>
                        </div>
                    </div>
                </div>
                
                <div id="manualIdentitySection">
                    <div class="form-group">
                        <label for="serverUsername">Username</label>
                        <input type="text" id="serverUsername" required>
                    </div>
                    <div class="form-group">
                        <label>Authentication Method</label>
                        <div class="auth-options">
                            <label class="radio-label">
                                <input type="radio" name="authType" value="password" id="authTypePassword" checked>
                                Password
                            </label>
                            <label class="radio-label">
                                <input type="radio" name="authType" value="key" id="authTypeKey">
                                SSH Key
                            </label>
                        </div>
                    </div>
                    <div class="form-group auth-section" id="passwordSection">
                        <label for="serverPassword">Password</label>
                        <input type="password" id="serverPassword">
                    </div>
                    <div class="form-group auth-section" id="keySection" style="display: none;">
                        <label for="privateKey">Private Key</label>
                        <div class="key-input-container">
                            <div class="key-upload-section">
                                <label class="file-upload-label">
                                    <input type="file" id="keyFileInput" class="key-file-input">
                                    <span class="upload-button"><i class="fas fa-upload"></i> Choose Key File</span>
                                </label>
                                <span id="selectedFileName" class="selected-file-name">No file selected</span>
                            </div>
                            <div class="divider">
                                <span>OR</span>
                            </div>
                            <textarea id="privateKey" rows="4" placeholder="Paste your private key here"></textarea>
                        </div>
                        <div class="sub-form-group">
                            <label for="keyPassphrase">Key Passphrase (if needed)</label>
                            <input type="password" id="keyPassphrase">
                        </div>
                    </div>
                </div>
                
                <div class="form-group">
                    <label for="serverPort">Port</label>
                    <input type="number" id="serverPort" value="22" required>
                </div>
                <div class="form-actions">
                    <button type="submit">Save</button>
                    <button type="button" id="cancelSave">Cancel</button>
                </div>
            </form>
        </div>
    </div>
    
    <!-- Manage Identities Modal -->
    <div id="identitiesModal" class="modal">
        <div class="modal-content">
            <span class="close">&times;</span>
            <h2>Manage Identities</h2>
            <div class="identities-container">
                <div class="identities-list-header">
                    <h3>Saved Identities</h3>
                    <button type="button" id="addIdentityBtn" class="add-identity-btn">+ Add Identity</button>
                </div>
                <div class="identities-list" id="identitiesList">
                    <div class="loading">Loading...</div>
                </div>
            </div>
        </div>
    </div>
    
    <!-- Add/Edit Identity Modal -->
    <div id="identityFormModal" class="modal">
        <div class="modal-content">
            <span class="close">&times;</span>
            <h2 id="identityFormTitle">Add Identity</h2>
            <form id="identityForm">
                <input type="hidden" id="identityId">
                <div class="form-group">
                    <label for="identityName">Identity Name</label>
                    <input type="text" id="identityName" required>
                </div>
                <div class="form-group">
                    <label for="identityUsername">Username</label>
                    <input type="text" id="identityUsername" required>
                </div>
                <div class="form-group">
                    <label>Authentication Method</label>
                    <div class="auth-options">
                        <label class="radio-label">
                            <input type="radio" name="identityAuthType" value="password" id="identityAuthTypePassword" checked>
                            Password
                        </label>
                        <label class="radio-label">
                            <input type="radio" name="identityAuthType" value="key" id="identityAuthTypeKey">
                            SSH Key
                        </label>
                    </div>
                </div>
                <div class="form-group auth-section" id="identityPasswordSection">
                    <label for="identityPassword">Password</label>
                    <input type="password" id="identityPassword">
                </div>
                <div class="form-group auth-section" id="identityKeySection" style="display: none;">
                    <label for="identityPrivateKey">Private Key</label>
                    <div class="key-input-container">
                        <div class="key-upload-section">
                            <label class="file-upload-label">
                                <input type="file" id="identityKeyFileInput" class="key-file-input">
                                <span class="upload-button"><i class="fas fa-upload"></i> Choose Key File</span>
                            </label>
                            <span id="identitySelectedFileName" class="selected-file-name">No file selected</span>
                        </div>
                        <div class="divider">
                            <span>OR</span>
                        </div>
                        <textarea id="identityPrivateKey" rows="4" placeholder="Paste your private key here"></textarea>
                    </div>
                    <div class="sub-form-group">
                        <label for="identityKeyPassphrase">Key Passphrase (if needed)</label>
                        <input type="password" id="identityKeyPassphrase">
                    </div>
                </div>
                <div class="form-actions">
                    <button type="submit">Save</button>
                    <button type="button" id="cancelIdentity">Cancel</button>
                    <button type="button" id="deleteIdentity" class="danger-button" style="display: none;">Delete</button>
                </div>
            </form>
        </div>
    </div>
    
    <!-- Add Folder Modal -->
    <div id="folderModal" class="modal">
        <div class="modal-content">
            <span class="close">&times;</span>
            <h2>Add Folder</h2>
            <form id="folderForm">
                <div class="form-group">
                    <label for="folderName">Folder Name</label>
                    <input type="text" id="folderName" required>
                </div>
                <div class="form-group">
                    <label for="folderColor">Folder Color (optional)</label>
                    <input type="color" id="folderColor" value="#007acc">
                </div>
                <div class="form-actions">
                    <button type="submit">Save</button>
                    <button type="button" id="cancelFolder">Cancel</button>
                    <button type="button" id="deleteFolder" class="danger-button" style="display: none;">Delete</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Snippets Modal -->
    <div id="snippetsModal" class="modal">
        <div class="modal-content">
            <span class="close">&times;</span>
            <h2>Code Snippets</h2>
            <div class="snippets-container">
                <div class="snippets-list-header">
                    <h3>Saved Snippets</h3>
                    <button type="button" id="addSnippetBtn" class="add-snippet-btn">+ Add Snippet</button>
                </div>
                <div class="snippets-list" id="snippetsList">
                    <div class="loading">Loading...</div>
                </div>
            </div>
        </div>
    </div>

    <!-- File Explorer Modal -->
    <div id="fileExplorerModal" class="modal">
        <div class="modal-content file-explorer-modal">
            <span class="close">&times;</span>
            <h2>File Explorer</h2>
            <div class="file-explorer-container">
                <div class="file-explorer-header">
                    <div class="file-explorer-path" id="currentPath">/</div>
                    <div class="file-explorer-actions">
                        <button type="button" id="newFileBtn" class="file-explorer-btn" title="New File">
                            <i class="fas fa-file-medical"></i>
                        </button>
                        <button type="button" id="uploadFileBtn" class="file-explorer-btn" title="Upload File">
                            <i class="fas fa-upload"></i>
                        </button>
                        <button type="button" id="refreshFilesBtn" class="file-explorer-btn" title="Refresh">
                            <i class="fas fa-sync-alt"></i>
                        </button>
                    </div>
                </div>
                <div class="file-explorer-breadcrumb" id="fileBreadcrumb">
                    <span class="breadcrumb-item root" data-path="/">/</span>
                </div>
                <div class="file-explorer-content" id="fileExplorerContent">
                    <div class="loading">Connecting to server...</div>
                </div>
                <div class="file-explorer-status" id="fileExplorerStatus">
                    Ready
                </div>
            </div>
        </div>
    </div>

    <!-- Add/Edit Snippet Modal -->
    <div id="snippetFormModal" class="modal">
        <div class="modal-content">
            <span class="close">&times;</span>
            <h2 id="snippetFormTitle">Add Snippet</h2>
            <form id="snippetForm">
                <input type="hidden" id="snippetId">
                <div class="form-group">
                    <label for="snippetName">Snippet Name</label>
                    <input type="text" id="snippetName" required>
                </div>
                <div class="form-group">
                    <label for="snippetContent">Content</label>
                    <textarea id="snippetContent" rows="8" required></textarea>
                </div>
                <div class="form-group">
                    <label for="snippetDescription">Description (optional)</label>
                    <textarea id="snippetDescription" rows="3"></textarea>
                </div>
                <div class="form-actions">
                    <button type="submit">Save</button>
                    <button type="button" id="cancelSnippet">Cancel</button>
                    <button type="button" id="deleteSnippet" class="danger-button" style="display: none;">Delete</button>
                </div>
            </form>
        </div>
    </div>

    <!-- File Upload Modal -->
    <div id="fileUploadModal" class="modal">
        <div class="modal-content">
            <span class="close">&times;</span>
            <h2>Upload File</h2>
            <form id="fileUploadForm" enctype="multipart/form-data">
                <div class="form-group">
                    <label for="uploadDestination">Upload to:</label>
                    <input type="text" id="uploadDestination" readonly>
                </div>
                <div class="form-group">
                    <label for="fileToUpload">Select File:</label>
                    <div class="file-upload-container">
                        <label class="file-upload-label">
                            <input type="file" id="fileToUpload" class="file-upload-input" required>
                            <span class="upload-button"><i class="fas fa-file"></i> Choose File</span>
                        </label>
                        <span id="selectedUploadFileName" class="selected-file-name">No file selected</span>
                    </div>
                </div>
                <div class="upload-progress" id="uploadProgress" style="display: none;">
                    <div class="progress-bar">
                        <div class="progress-fill" id="progressFill"></div>
                    </div>
                    <div class="progress-text" id="progressText">0%</div>
                </div>
                <div id="uploadError" class="error-message" style="display: none;"></div>
                <div class="form-actions">
                    <button type="submit" id="startUploadBtn">Upload</button>
                    <button type="button" id="cancelUpload">Cancel</button>
                </div>
            </form>
        </div>
    </div>
    
    <!-- Code Editor Modal -->
    <div id="codeEditorModal" class="modal">
        <div class="modal-content code-editor-modal">
            <div class="code-editor-header">
                <div class="editor-file-path" id="editorFilePath"></div>
                <div class="code-editor-actions">
                    <button id="saveCodeBtn" class="code-editor-btn save-btn">
                        <i class="fas fa-save"></i> Save
                    </button>
                    <span class="close">&times;</span>
                </div>
            </div>
            <div class="code-editor-container">
                <textarea id="codeEditorTextarea"></textarea>
            </div>
            <div id="editorStatus" class="editor-status"></div>
        </div>
    </div>
    
    <!-- Hidden file input for temporary use -->
    <input type="file" id="hiddenFileInput" style="display: none;">
    
    <!-- New File Modal -->
    <div id="newFileModal" class="modal">
        <div class="modal-content">
            <span class="close">&times;</span>
            <h2>Create New File</h2>
            <form id="newFileForm">
                <div class="form-group">
                    <label for="newFileName">File Name</label>
                    <input type="text" id="newFileName" required placeholder="example.txt">
                </div>
                <div class="form-group">
                    <label for="newFileContent">Initial Content</label>
                    <textarea id="newFileContent" rows="12"></textarea>
                </div>
                <div class="form-actions">
                    <button type="submit" id="createFileBtn">Create</button>
                    <button type="button" id="cancelNewFile">Cancel</button>
                </div>
            </form>
        </div>
    </div>
</div>
</body>
</html> 